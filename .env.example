# Backend origin or API root. Both forms are supported:
# VITE_API_BASE_URL=https://api.example.com
# VITE_API_BASE_URL=https://api.example.com/api
#
# Leave VITE_API_BASE_URL unset during local development to use the Vite proxy.
# The proxy forwards /api requests to http://localhost:5024 by default.
# Override it only when the backend runs on a different local address.
VITE_API_PROXY_TARGET=http://localhost:5024
